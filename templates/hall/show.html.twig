{% extends 'base.html.twig' %}

{% block title %}Hall
{% endblock %}

{% block main %}
	<style>
		.piece-link
		{
			text-decoration: none;
			color: #007bff; /* Bootstrap primary link color */
		}
		.piece-link:hover
		{
			color: #0056b3; /* Darker primary color for hover */
		}

		.btn[disabled]
		{
			pointer-events: none;
			opacity: 0.6;
		}
	</style>

	<h1 class="my-5 text-center">Hall Details</h1>

	<div class="container">
		<div class="card shadow-sm mb-5">
			<div class="card-body">
				<table class="table table-striped">
					<tbody>
						<tr>
							<th scope="row">Id</th>
							<td>{{ hall.id }}</td>
						</tr>
						<tr>
							<th scope="row">Description</th>
							<td>{{ hall.description }}</td>
						</tr>
						<tr>
							<th scope="row">Published</th>
							<td>{{ hall.published ? 'Yes' : 'No' }}</td>
						</tr>
						<tr>
							<th scope="row">Pieces</th>
							<td>
								{% if hall.pieces|length > 0 %}
									<ul class="list-unstyled">
										{% for piece in hall.pieces %}
											<li>
												<a class="piece-link" href="{{ path('app_hall_piece_show',{ 'hall_id': hall.id, 'piece_id': piece.id }) }}">
													{{ piece.name }}
												</a>
											</li>
										{% endfor %}
									</ul>
								{% else %}
									<span class="text-muted">No pieces available</span>
								{% endif %}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="d-flex gap-3 justify-content-start">
			<a href="{{ path('app_hall_index') }}" class="btn btn-secondary">Halls List</a>

			{% if is_granted('ROLE_ADMIN') or hall.member == app.user %}
				<a href="{{ path('app_hall_edit', {'id': hall.id}) }}" class="btn btn-primary">Edit</a>
				{{ include('hall/_delete_form.html.twig', { 'class': 'btn btn-danger' }) }}
			{% else %}
				<button class="btn btn-primary" disabled>Edit</button>
				<button class="btn btn-danger" disabled>Delete</button>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Piece
{% endblock %}

{% block main %}
	<div class="container my-5">
		<h1 class="mb-4">{{ piece.name }}</h1>

		<div class="card shadow-sm mb-4">
			<div class="card-body">
				<div class="row">
					<div class="col-md-4">

						<img class="img-fluid rounded mb-3" src="{{ vich_uploader_asset(piece, 'imageFile') }}" alt="{{ piece.name }}">
					</div>
					<div class="col-md-8">
						<table class="table table-striped">
							<tbody>
								<tr>
									<th scope="row">Id</th>
									<td>{{ piece.id }}</td>
								</tr>
								<tr>
									<th scope="row">Name</th>
									<td>{{ piece.name }}</td>
								</tr>
								<tr>
									<th scope="row">Description</th>
									<td>{{ piece.description }}</td>
								</tr>
								<tr>
									<th scope="row">Type</th>
									<td>{{ piece.type }}</td>
								</tr>
								<tr>
									<th scope="row">Acquired</th>
									<td>{{ piece.acquired ? piece.acquired|date('Y-m-d') : 'N/A' }}</td>
								</tr>
								<tr>
									<th scope="row">Era</th>
									<td>{{ piece.era }}</td>
								</tr>
								<tr>
									<th scope="row">Halls</th>
									<td>
										{% for hall in piece.halls %}
											<span class="badge bg-secondary">{{ hall.description }}</span>
										{% else %}
											<span class="text-muted">No halls assigned</span>
										{% endfor %}
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="d-flex gap-3">
			<a href="{{ path('app_piece_index') }}" class="btn btn-outline-dark">Go to All Pieces</a>
			<a href="{{ path('app_piece_edit', {'id': piece.id}) }}" class="btn btn-primary">Edit</a>
			{{ include('piece/_delete_form.html.twig', { 'class': 'btn btn-danger' }) }}
		</div>
	</div>
{% endblock %}

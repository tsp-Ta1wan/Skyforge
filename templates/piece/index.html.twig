{% extends 'base.html.twig' %}

{% block title %}Pieces List
{% endblock %}

{% block main %}
	<style>
		table
		{
			max-width: 80vw;
			margin: 5vh 0 0 5vw;
			font-size: 1.2rem;
			text-align: start;
		}

		td,
		th
		{
			height: 4vh;
			padding: 0 0 0 3vw !important;
			vertical-align: middle; /* Ensures content is vertically centered */
		}

		thead th
		{
			padding: 0 0 1vh 3vw !important;
		}

		/* Applies only to the table links */
		table a
		{
			text-decoration: none;
			color: inherit;
			display: block;
			width: 100%;
			height: 80%;
			padding: 1.5vh 0; /* Adjust padding for better centering within cells */
		}

		a:hover
		{
			color: black;
		}

		/* Ensure buttons are vertically centered */
		.btn
		{
			padding: 5px 10px; /* Adjust padding for smaller buttons */
		}
	</style>


	<h1 style="margin:15vh 0 0 5vw" class="ms-5">Pieces List</h1>

	<table class="table table-hover">
		<thead>
			<tr>
				<th scope="col">Id</th>
				<th scope="col">Name</th>
				<th scope="col">Description</th>
				<th scope="col">Type</th>
				<th scope="col">Acquired</th>
				<th scope="col">Era</th>
				<th scope="col">Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for piece in pieces %}
				<tr>
					<th scope="row">
						<a href="{{ path('app_piece_show', {'id': piece.id}) }}">
							{{ piece.id }}
						</a>
					</th>
					<td>
						<a href="{{ path('app_piece_show', {'id': piece.id}) }}">
							{{ piece.name }}
						</a>
					</td>
					<td>
						<a href="{{ path('app_piece_show', {'id': piece.id}) }}">
							{{ piece.description }}
						</a>
					</td>
					<td>{{ piece.type }}</td>
					<td>{{ piece.acquired ? piece.acquired|date('Y-m-d') : '' }}</td>
					<td>{{ piece.era }}</td>
					<td>
						<a href="{{ path('app_piece_edit', {'id': piece.id}) }}" class="btn btn-dark btn-sm">Edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="7" class="text-center">No records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<figure style="margin:10vh 0 0 5vw">
		<blockquote class="blockquote">
			<h4>Random medieval fact: Some pieces of art were hidden for centuries!</h4>
		</blockquote>
		<figcaption class="blockquote-footer">
			Historical Trivia
		</figcaption>
	</figure>
{% endblock %}

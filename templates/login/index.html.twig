{% extends 'base.html.twig' %}

{% block title %}Login
{% endblock %}

{% block main %}
	<div class="container d-flex justify-content-center align-items-center" style="height: 80vh; position: relative; z-index: 1;">
		<div class="card shadow-lg" style="width: 28rem; background: rgba(255, 255, 255, 0.85);">
			<div class="card-body">
				<h3 class="card-title text-center mb-4">Welcome Back</h3>

				{% if error %}
					<div class="alert alert-danger text-center">
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</div>
				{% endif %}

				<form action="{{ path('app_login') }}" method="post">
					<div class="form-outline mb-3">
						<label for="username" class="form-label">Email</label>
						<input type="text" id="username" name="_username" class="form-control" placeholder="Enter your email" value="{{ last_username }}" required>
					</div>

					<div class="form-outline mb-3">
						<label for="password" class="form-label">Password</label>
						<input type="password" id="password" name="_password" class="form-control" placeholder="Enter your password" required>
					</div>

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<button type="submit" class="btn btn-primary btn-block w-100">Login</button>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body
		{
			position: relative;
			min-height: 100vh;
			margin: 0;
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			background-attachment: fixed;
		}

		/* Pseudo-element to apply dimming effect only to the background */
		body::before
		{
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5); /* Dimming effect */
			z-index: 0; /* Behind the content */
		}

		.container
		{
			position: relative;
			z-index: 1; /* Ensure form stays above the dimmed background */
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		document.addEventListener( "DOMContentLoaded", function ()
{

const randomIndex = Math.floor( Math.random() * 6 ); // Random number between 0 and 5
const imagePath = '/images/login/'; // Adjust path if needed
document.body.style.backgroundImage = `url('${ imagePath }login_${ randomIndex }.jpg')`;

} );
	</script>
{% endblock %}
